@model DeleteModel
@{ ViewData["Title"] = "Remove member"; ViewData["Nav"] = "team"; }

<div class="page-head"><h1>Remove member</h1></div>

<div class="form-card">
    <p>Remove <strong>@Model.Member!.Name</strong> from the team?
        Their assigned tasks will become unassigned. This cannot be undone.</p>
    <form method="post">
        <input type="hidden" name="id" value="@Model.Member.Id" />
        <div class="form-actions">
            <a class="btn" asp-page="Index">Cancel</a>
            <button class="btn btn-danger" type="submit">Remove member</button>
        </div>
    </form>
</div>
