@model EditModel
@{ ViewData["Title"] = "Edit member"; ViewData["Nav"] = "team"; }

<div class="page-head"><h1>Edit member</h1></div>

<form method="post" class="form-card">
    <input type="hidden" asp-for="Member.Id" />
    <div asp-validation-summary="All" class="validation"></div>
    <label class="field"><span>Full name</span><input asp-for="Member.Name" /></label>
    <label class="field"><span>Email</span><input asp-for="Member.Email" type="email" /></label>
    <div class="field-row">
        <label class="field"><span>Title / position</span><input asp-for="Member.Title" /></label>
        <label class="field"><span>Organization / unit</span><input asp-for="Member.Organization" /></label>
    </div>
    <div class="field-row">
        <label class="field"><span>Role</span>
            <select asp-for="Member.Role" asp-items="Html.GetEnumSelectList<MemberRole>()"></select></label>
        <label class="field field-color"><span>Avatar colour</span><input asp-for="Member.ColorHex" type="color" /></label>
    </div>
    <div class="form-actions">
        <a class="btn" asp-page="Index">Cancel</a>
        <button class="btn btn-primary" type="submit">Save changes</button>
    </div>
</form>
