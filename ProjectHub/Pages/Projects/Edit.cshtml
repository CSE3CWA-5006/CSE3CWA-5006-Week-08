@model EditModel
@{
    ViewData["Title"] = "Edit project"; ViewData["Nav"] = "projects";
    var icons = new[] { "📁","🌐","📱","📣","🚀","🧪","📊","🛠️","🎯","💡","🗂️","🏗️" };
}

<div class="page-head"><h1>Edit project</h1></div>

<form method="post" class="form-card">
    <input type="hidden" asp-for="Project.Id" />
    <div asp-validation-summary="All" class="validation"></div>
    <label class="field"><span>Project name</span><input asp-for="Project.Name" /></label>
    <label class="field"><span>Description</span><textarea asp-for="Project.Description" rows="3"></textarea></label>
    <div class="field-row">
        <label class="field"><span>Icon</span>
            <select asp-for="Project.Icon">
                @foreach (var ic in icons) { <option value="@ic">@ic</option> }
            </select></label>
        <label class="field field-color"><span>Colour</span><input asp-for="Project.ColorHex" type="color" /></label>
    </div>
    <div class="field-row">
        <label class="field"><span>Start date</span><input asp-for="Project.StartDate" type="date" /></label>
        <label class="field"><span>Target end date</span><input asp-for="Project.EndDate" type="date" /></label>
    </div>
    <label class="field"><span>Status</span>
        <select asp-for="Project.Status">
            <option value="0">Not started</option>
            <option value="1">In progress</option>
            <option value="2">Delayed</option>
            <option value="3">Completed</option>
        </select></label>
    <div class="form-actions">
        <a class="btn" asp-page="Details" asp-route-id="@Model.Project.Id">Cancel</a>
        <button class="btn btn-primary" type="submit">Save changes</button>
    </div>
</form>

<div class="danger-zone">
    <div>
        <strong>Delete this project</strong>
        <p class="muted">Permanently removes the project and all of its tasks. This cannot be undone.</p>
    </div>
    <a class="btn btn-danger" asp-page="Delete" asp-route-id="@Model.Project.Id">Delete project</a>
</div>
