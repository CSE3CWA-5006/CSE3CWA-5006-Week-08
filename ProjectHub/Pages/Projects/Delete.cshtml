@model DeleteModel
@{ ViewData["Title"] = "Delete project"; ViewData["Nav"] = "projects"; }

<div class="page-head"><h1>Delete project</h1></div>

<div class="form-card">
    <p>Delete <strong>@Model.Project!.Name</strong> and its
        <strong>@Model.Project.Tasks.Count</strong> task(s)? This cannot be undone.</p>
    <form method="post">
        <input type="hidden" name="id" value="@Model.Project.Id" />
        <div class="form-actions">
            <a class="btn" asp-page="Details" asp-route-id="@Model.Project.Id">Cancel</a>
            <button class="btn btn-danger" type="submit">Delete project</button>
        </div>
    </form>
</div>
