@model SearchModel
@{
    ViewData["Title"] = "Search"; ViewData["Nav"] = ""; ViewData["Query"] = Model.Q;
    int Done(Project p) => p.Tasks.Count(t => !t.IsArchived && t.Status == WorkStatus.Completed);
    int Total(Project p) => p.Tasks.Count(t => !t.IsArchived);
}

<div class="page-head"><h1>Search</h1></div>

@if (string.IsNullOrEmpty(Model.Q))
{
    <p class="muted">Type in the search box above to find projects (by name or description) and people (by name, title or organization).</p>
}
else
{
    <p class="muted">Results for &ldquo;<b>@Model.Q</b>&rdquo; — @Model.Projects.Count project(s), @Model.Members.Count member(s).</p>

    <h2 class="section-title">Projects</h2>
    @if (Model.Projects.Count == 0) { <p class="muted">No matching projects.</p> }
    <div class="project-grid">
        @foreach (var p in Model.Projects)
        {
            <a class="project-card" asp-page="/Projects/Details" asp-route-id="@p.Id">
                <div class="project-card-top">
                    <span class="proj-icon">@p.Icon</span>
                    <span class="project-name">@p.Name</span>
                    <span class="status-pill proj-@((int)p.Status)">@StatusLabels.Of(p.Status)</span>
                </div>
                <p class="project-desc">@p.Description</p>
                <div class="project-meta"><span></span><span>@Done(p)/@Total(p) tasks</span></div>
            </a>
        }
    </div>

    <h2 class="section-title">People</h2>
    @if (Model.Members.Count == 0) { <p class="muted">No matching people.</p> }
    <table class="table">
        <tbody>
            @foreach (var u in Model.Members)
            {
                <tr>
                    <td class="cell-task"><span class="avatar lg" style="background:@u.ColorHex">@u.Initials</span> @u.Name</td>
                    <td>@u.Title</td><td>@u.Organization</td>
                    <td><span class="role-pill role-@((int)u.Role)">@u.Role</span></td>
                    <td style="text-align:right"><a class="btn btn-sm" asp-page="/Members/Index">Open Team</a></td>
                </tr>
            }
        </tbody>
    </table>
}
