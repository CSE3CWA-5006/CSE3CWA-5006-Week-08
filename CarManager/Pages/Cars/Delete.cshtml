@page "{id:int}"
@model CarManager.Pages.Cars.DeleteModel

@{
    ViewData["Title"] = "Delete car";
}

<h1>Delete car</h1>
<p class="text-muted">This page confirms deletion before removing the record from SQLite.</p>

<div class="card card-body border-danger shadow-sm">
    <h2 class="h5">@Model.Car.Make @Model.Car.Model</h2>
    <dl class="row mb-0">
        <dt class="col-sm-2">Year</dt>
        <dd class="col-sm-10">@Model.Car.Year</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@Model.Car.Price.ToString("C")</dd>
    </dl>
</div>

<form method="post" class="mt-3 d-flex gap-2">
    <input type="hidden" asp-for="Car.Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
