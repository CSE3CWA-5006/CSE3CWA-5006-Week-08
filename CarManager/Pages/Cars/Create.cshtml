@page
@model CarManager.Pages.Cars.CreateModel

@{
    ViewData["Title"] = "Add car";
}

<h1>Add car</h1>
<p class="text-muted">This form posts to the Razor Page handler, which validates the model and saves it through EF Core.</p>

<form method="post" class="card card-body shadow-sm">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Car.Make" class="form-label"></label>
        <input asp-for="Car.Make" class="form-control" placeholder="Toyota" />
        <span asp-validation-for="Car.Make" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Car.Model" class="form-label"></label>
        <input asp-for="Car.Model" class="form-control" placeholder="Corolla" />
        <span asp-validation-for="Car.Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Car.Year" class="form-label"></label>
        <input asp-for="Car.Year" class="form-control" />
        <span asp-validation-for="Car.Year" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Car.Price" class="form-label"></label>
        <input asp-for="Car.Price" class="form-control" />
        <span asp-validation-for="Car.Price" class="text-danger"></span>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save car</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
