@page "{id:int}"
@model CarManager.Pages.Cars.EditModel

@{
    ViewData["Title"] = "Edit car";
}

<h1>Edit car</h1>
<p class="text-muted">The route supplies the car ID. The page loads that record, binds the edited values and saves the changes.</p>

<form method="post" class="card card-body shadow-sm">
    <input type="hidden" asp-for="Car.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Car.Make" class="form-label"></label>
        <input asp-for="Car.Make" class="form-control" />
        <span asp-validation-for="Car.Make" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Car.Model" class="form-label"></label>
        <input asp-for="Car.Model" class="form-control" />
        <span asp-validation-for="Car.Model" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Car.Year" class="form-label"></label>
        <input asp-for="Car.Year" class="form-control" />
        <span asp-validation-for="Car.Year" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Car.Price" class="form-label"></label>
        <input asp-for="Car.Price" class="form-control" />
        <span asp-validation-for="Car.Price" class="text-danger"></span>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Update car</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
