@page
@model CarManager.Pages.Cars.IndexModel

@{
    ViewData["Title"] = "Cars";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h1 class="mb-1">Car inventory</h1>
        <p class="text-muted mb-0">Razor Pages reads the same SQLite data used by the API.</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">Add car</a>
</div>

<div class="alert alert-info">
    API test: open <code>/api/cars</code> in the browser or Postman to see the same records as JSON.
</div>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Make</th>
            <th>Model</th>
            <th>Year</th>
            <th>Price</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var car in Model.Cars)
        {
            <tr>
                <td>@car.Make</td>
                <td>@car.Model</td>
                <td>@car.Year</td>
                <td>@car.Price.ToString("C")</td>
                <td class="text-end">
                    <a asp-page="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-page="Delete" asp-route-id="@car.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
